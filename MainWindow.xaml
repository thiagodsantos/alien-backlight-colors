<Window x:Class="AlienCommandCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alien Command Center — Alien Backlight Colors"
        Width="1420"
        Height="960"
        MinWidth="1120"
        MinHeight="760"
        Background="{StaticResource AppBackground}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource QuanticoFont}"
        Icon="{StaticResource AlienLogo}"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="15" Background="#0B0A16" BorderBrush="#51416B" BorderThickness="1" ClipToBounds="True">
                        <Image Source="{StaticResource AlienLogo}" Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ALIEN COMMAND CENTER" Foreground="{StaticResource AccentBrush}" FontSize="14" FontWeight="Bold" FontFamily="{StaticResource GoldmanFont}" />
                        <TextBlock Text="Alien Backlight Colors" FontSize="28" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#111022" BorderBrush="#35284C" BorderThickness="1" CornerRadius="18" Padding="13,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding DeviceStatusLabel}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18,15" Margin="0,0,0,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="11" Background="#171526" VerticalAlignment="Center">
                        <TextBlock Text="⌨" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DeviceHeadline}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{Binding DeviceDescription}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Remove AWCC" Click="RemoveAwcc_Click" Margin="16,0,0,0" ToolTip="Launch the registered Dell AWCC uninstaller with UAC confirmation." />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.95*" MinWidth="330" />
                    <ColumnDefinition Width="2.05*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Margin="20,0,0,0">

                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20">
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="ZONE CONTROLS" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="Colors per zone, one shared effect" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" />
                                </StackPanel>
                                <TextBlock Text="4 ZONES" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                            </Grid>
                            <Border Background="#090A13" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="1.15*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="EFFECT FOR ALL ZONES" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding EffectOptions}" SelectedItem="{Binding SelectedEffect, UpdateSourceTrigger=PropertyChanged}" Background="#090A13" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="Effects run in software using static color updates; keep the app running." Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,5,0,0" />
                                        <TextBlock Text="Matrix pulses through green shades across all four zones, using the selected brightness." Foreground="{StaticResource AccentBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,5,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedEffect}" Value="Matrix">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Tunnel fades white highlights across the center zones, then the outer zones, before resetting." Foreground="{StaticResource AccentBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,5,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedEffect}" Value="Tunnel">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Ping Pong moves a white highlight from left to right and back, with brightness set by the selected level." Foreground="{StaticResource AccentBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,5,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedEffect}" Value="PingPong">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Flashing alternates all zones between their selected colors and black; higher effect speed blinks faster." Foreground="{StaticResource AccentBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,5,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedEffect}" Value="Flashing">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Wave speed controls how quickly the highlight moves between zones." Foreground="{StaticResource AccentBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,5,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedEffect}" Value="Wave">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="EFFECT SPEED" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                                            <TextBlock Text="{Binding EffectSpeedLabel}" HorizontalAlignment="Right" Foreground="{StaticResource TextBrush}" FontSize="10" />
                                        </Grid>
                                        <Slider Minimum="1" Maximum="100" Value="{Binding EffectSpeed, UpdateSourceTrigger=PropertyChanged}" TickFrequency="1" IsSnapToTickEnabled="False" Foreground="{StaticResource AccentBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="BACKLIGHT BRIGHTNESS" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                                            <TextBlock Text="{Binding BrightnessLabel}" HorizontalAlignment="Right" Foreground="{StaticResource TextBrush}" FontSize="10" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider Minimum="0" Maximum="100" TickFrequency="10" Value="{Binding Brightness, UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="{Binding BacklightToggleLabel}" Command="{Binding ToggleBacklightCommand}" Padding="7,5" Margin="8,0,0,0" FontSize="9" ToolTip="Turn the keyboard backlight on or off immediately." />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Grid Margin="2,0,2,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="BACKLIGHT ACTIVE FOR (SECONDS)" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Text="0 keeps it active while the app is running; otherwise it turns off after inactivity." Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,4,8,0" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding BacklightActiveSeconds, UpdateSourceTrigger=LostFocus}" MaxLength="5" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" ToolTip="Seconds of keyboard inactivity before the backlight turns off. Set to 0 to keep it active while the app is running." />
                            </Grid>
                            <TextBlock Text="Apply starts the shared effect with the selected brightness and zone colors. A brightness of 0 applies as 100%." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="2,0,2,12" />
                            <ItemsControl ItemsSource="{Binding Zones}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="9" Margin="0,0,7,8">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,7">
                                                    <TextBlock Text="{Binding ZoneName}" FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="ZONE" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" />
                                                </Grid>
                                                <Border Height="30" Background="{Binding ColorBrush}" CornerRadius="7" Margin="0,0,0,7" />

                                                <TextBlock Text="PRIMARY COLOR" Foreground="{StaticResource MutedBrush}" FontSize="8" FontWeight="Bold" />
                                                <Grid Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="29" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" FontFamily="Consolas" FontSize="12" />
                                                    <Button Grid.Column="1" Content="Pick" Padding="7,5" Margin="5,0,0,0" Click="PickPrimaryColor_Click" FontSize="10" />
                                                    <Border Grid.Column="2" Background="{Binding ColorBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Margin="6,0,0,0" />
                                                </Grid>
                                                <TextBlock Text="{Binding ColorError}" Foreground="{StaticResource DangerBrush}" FontSize="9" Margin="0,4,0,0" />

                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                <Button Content="Restore default (red)" Command="{Binding ResetDeviceCommand}" Margin="0,0,9,0" ToolTip="Applies static red to each of the four light IDs." />
                                <Button Content="Apply to keyboard" Command="{Binding ApplyCurrentCommand}" Background="{StaticResource ActionBackground}" BorderBrush="{StaticResource ActionBorder}" ToolTip="Starts the selected effect using repeated supported static color updates." />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20">
                    <StackPanel>
                        <TextBlock Text="PRESET LIBRARY" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="Save your favorite looks" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,4" />
                        <TextBlock Text="Presets are stored locally on this PC." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,16" />

                        <TextBlock Text="PRESET NAME" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Save current look" Command="{Binding SavePresetCommand}" Margin="0,9,0,17" Background="{StaticResource ActionBackground}" BorderBrush="{StaticResource ActionBorder}" />

                        <Grid Margin="0,0,0,7">
                            <TextBlock Text="SAVED PRESETS" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                            <TextBlock Text="BUILT-IN + CUSTOM" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="8" FontWeight="Bold" />
                        </Grid>
                        <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Height="285">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:MMM d}}" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="Ready to preview" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="BUILT-IN" Foreground="{StaticResource MutedBrush}" FontSize="8" FontWeight="Bold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Load to editor" Command="{Binding LoadPresetCommand}" />
                            <Button Grid.Column="2" Content="Apply preset" Command="{Binding ApplyPresetCommand}" Background="{StaticResource ActionBackground}" BorderBrush="{StaticResource ActionBorder}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Rename selected" Command="{Binding RenamePresetCommand}" />
                            <Button Grid.Column="2" Content="Delete" Command="{Binding DeletePresetCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3" Background="#0B0C16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="13,10" Margin="0,18,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="ALIEN COMMAND CENTER" Foreground="{StaticResource MutedBrush}" FontSize="8" FontFamily="{StaticResource GoldmanFont}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="2,0,10,0" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusBrush}" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
