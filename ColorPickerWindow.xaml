<Window x:Class="AlienCommandCenter.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a color"
        Width="390"
        Height="510"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource QuanticoFont}"
        Icon="{StaticResource AlienLogo}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="COLOR PICKER" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
            <TextBlock Text="Choose an RGB color" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="105" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="HEX VALUE" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,0,5" />
                <TextBox x:Name="HexInput" Text="#59D9F5" MaxLength="7" FontFamily="Consolas" FontSize="14" TextChanged="HexInput_TextChanged" />
            </StackPanel>
            <Border x:Name="ColorPreview" Grid.Column="1" Background="#59D9F5" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="12,19,0,0" />
        </Grid>
        <TextBlock x:Name="HexError" Grid.Row="2" Text="Enter a 6-digit hex value, such as #59D9F5." Foreground="{StaticResource DangerBrush}" FontSize="10" Margin="0,5,0,0" Visibility="Collapsed" />

        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="RGB COMPONENTS" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,0,10" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="36" />
                </Grid.RowDefinitions>
                <TextBlock Text="R" Foreground="#FF8585" VerticalAlignment="Center" FontWeight="Bold" />
                <Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="RgbSlider_ValueChanged" VerticalAlignment="Center" />
                <TextBlock x:Name="RedValue" Grid.Column="2" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Consolas" />
                <TextBlock Grid.Row="1" Text="G" Foreground="#8CE6A3" VerticalAlignment="Center" FontWeight="Bold" />
                <Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="RgbSlider_ValueChanged" VerticalAlignment="Center" />
                <TextBlock x:Name="GreenValue" Grid.Row="1" Grid.Column="2" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Consolas" />
                <TextBlock Grid.Row="2" Text="B" Foreground="#8FBFFF" VerticalAlignment="Center" FontWeight="Bold" />
                <Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="RgbSlider_ValueChanged" VerticalAlignment="Center" />
                <TextBlock x:Name="BlueValue" Grid.Row="2" Grid.Column="2" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Consolas" />
            </Grid>

            <TextBlock Text="QUICK COLORS" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" Margin="0,17,0,7" />
            <UniformGrid Columns="8" HorizontalAlignment="Left">
                <Button Tag="#C04EFF" Background="#C04EFF" Width="29" Height="29" Padding="0" Margin="2" Click="PaletteColor_Click" ToolTip="Neon violet" />
                <Button Tag="#9A5CFF" Background="#9A5CFF" Width="29" Height="29" Padding="0" Margin="2" Click="PaletteColor_Click" ToolTip="Purple" />
                <Button Tag="#686EFF" Background="#686EFF" Width="29" Height="29" Padding="0" Margin="2" Click="PaletteColor_Click" ToolTip="Indigo" />
                <Button Tag="#4FAEFF" Background="#4FAEFF" Width="29" Height="29" Padding="0" Margin="2" Click="PaletteColor_Click" ToolTip="Blue" />
                <Button Tag="#4FD9FF" Background="#4FD9FF" Width="29" Height="29" Padding="0" Margin="2" Click="PaletteColor_Click" ToolTip="Cyan" />
                <Button Tag="#4FF0CE" Background="#4FF0CE" Width="29" Height="29" Padding="0" Margin="2" Click="PaletteColor_Click" ToolTip="Turquoise" />
                <Button Tag="#4FF0A2" Background="#4FF0A2" Width="29" Height="29" Padding="0" Margin="2" Click="PaletteColor_Click" ToolTip="Neon green" />
                <Button Tag="#F2F5F7" Background="#F2F5F7" Width="29" Height="29" Padding="0" Margin="2" Click="PaletteColor_Click" ToolTip="White" />
            </UniformGrid>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="Cancel" IsCancel="True" />
            <Button Grid.Column="2" Content="Use this color" IsDefault="True" Click="UseColor_Click" Background="{StaticResource ActionBackground}" BorderBrush="{StaticResource ActionBorder}" />
        </Grid>
    </Grid>
</Window>
